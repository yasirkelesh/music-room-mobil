EXPO_PUBLIC_API_URL=http://localhost:8085

# Google sign-in: the *Web* OAuth client id the API is configured with (GOOGLE_CLIENT_ID on the server).
# A client id is public; the secret lives only on the server.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# The https page Google redirects to (docs/oauth/index.html, served by GitHub Pages). It must be listed
# under "Authorized redirect URIs" of that client.
EXPO_PUBLIC_OAUTH_REDIRECT=https://yasirkelesh.github.io/music-room-mobil/oauth/
